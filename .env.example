# URLShield Environment Configuration
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
SECRET_KEY=urlshield-super-secret-key-change-in-production

# Database Configuration (SQLite local, PostgreSQL for cloud deployment)
DATABASE_URL=sqlite:///urlshield.db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/urlshield

# Rate Limiting
RATELIMIT_DEFAULT=60 per minute
RATELIMIT_SCAN=20 per minute
RATELIMIT_STORAGE_URI=memory://

# Security & CORS
CORS_ALLOWED_ORIGINS=*
ENABLE_OPTIONAL_DNS_LOOKUPS=false
DNS_TIMEOUT_SECONDS=1.5

# Artifact Paths
MODEL_PATH=models/phishing_model.joblib
METADATA_PATH=models/model_metadata.json
SCHEMA_PATH=models/feature_schema.json
